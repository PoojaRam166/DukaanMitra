PORT=5000

# Local dev example. In production, use your managed Postgres host's
# connection string (Render/Railway/Supabase/Neon all provide one).
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<database>

JWT_SECRET=<any-long-random-string>

# The deployed frontend's exact origin (no trailing slash), e.g.
# https://your-app.vercel.app — required for CORS + the auth cookie to work.
CLIENT_URL=http://localhost:8443

# Set to "production" on your host (Render/Railway set this automatically
# in most cases, but confirm). Switches the auth cookie to
# secure + sameSite=none (needed when frontend and backend are on
# different domains) and enables SSL for the Postgres connection.
NODE_ENV=production

# Cloudinary account (free tier is fine) — used to store profile-photo
# uploads so they survive restarts/redeploys on hosts with an ephemeral
# filesystem. Find these on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
